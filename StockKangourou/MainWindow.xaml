<Window x:Class="StockKangourou.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StockKangourou"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.CommandBindings>
        <CommandBinding x:Name="SaveCommand" Command="ApplicationCommands.Save" CanExecute="SaveCommand_CanExecute" Executed="SaveCommand_Executed" />
        <CommandBinding x:Name="OpenCommand" Command="ApplicationCommands.Open" CanExecute="OpenCommand_CanExecute" Executed="OpenCommand_Executed"/>
    </Window.CommandBindings>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Images\kangoooo.jpg"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="217.02"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="173*"/>
                <ColumnDefinition Width="177*"/>
                <ColumnDefinition Width="50*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Row="0" Grid.Column="1" Margin="10">
                    <TextBlock Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Code :" Width="50px"></TextBlock>
                    <TextBox Margin="25,0" Height="20" VerticalAlignment="Center" Text="{Binding TheKangourou.codeKangourou, Mode=TwoWay}"/>
                </DockPanel>
                <DockPanel Grid.Row="1" Grid.Column="1" Margin="10">
                    <TextBlock Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="center" Text="Nom :" Width="50px"></TextBlock>
                    <TextBox Margin="25,0" Height="20" VerticalAlignment="Center" Text="{Binding TheKangourou.nomKangourou, Mode=TwoWay}"/>
                </DockPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="10">
                    <DockPanel Margin="2">
                        <TextBlock Foreground="WHITE" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Taille :" Width="50px" RenderTransformOrigin="4.267,2.493"></TextBlock>
                        <TextBox Margin="25,0" Height="20" Text="{Binding TheKangourou.tailleKangourou, Mode=TwoWay}" />
                    </DockPanel>
                </StackPanel>
                <DockPanel Grid.Row="3" Grid.Column="1" Margin="10,0">
                    <TextBlock Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Poids :" Width="50px"></TextBlock>
                    <TextBox Margin="25,0" Height="20" VerticalAlignment="Center" Text="{Binding TheKangourou.poidsKangourou, Mode=TwoWay}"/>
                </DockPanel>
                <DockPanel Grid.Row="4" Grid.Column="1" Margin="10">
                    <TextBlock Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Width="50px" Text="Race : "></TextBlock>
                    <ComboBox Margin="25,0" Height="20" VerticalAlignment="Center" SelectedItem="{Binding TheKangourou.raceKangourou, Mode=TwoWay}" ItemsSource="{Binding RaceKangourou, Mode=OneWay}"/>
                </DockPanel>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Button Background="Orange"  Grid.Row="0" Margin="10" Name="Stocker" Content="Stocker" Click="Stocker_Click"/>
                <Button Background="OrangeRed"  Click="Relâcher_Click"  Grid.Row="1" Margin="10" Name="Relâcher" Content="Relâcher"/>
                <Button Background="LightGreen"  Grid.Row="2" Margin="10" Name="Adopter" Content="Adopter" Click="Adopter_Click"/>
            </Grid>
            <Label Content="Les australopithèques" HorizontalAlignment="Left" Margin="20,78,0,0" VerticalAlignment="Top" Width="340" FontFamily="Kangaroo Court" FontSize="40" FontWeight="Bold" RenderTransformOrigin="0.495,2.399" Foreground="#FF2055DF" Grid.ColumnSpan="2">
                <Label.Effect>
                    <BlurEffect/>
                </Label.Effect>
            </Label>
            <Ellipse HorizontalAlignment="Left" Height="90" Margin="10,52,0,0" Stroke="#FF2055DF" VerticalAlignment="Top" Width="360" Grid.ColumnSpan="2">
                <Ellipse.Effect>
                    <BlurEffect/>
                </Ellipse.Effect>
            </Ellipse>
      
            <Button Content="Musique♪" Click="Button_Click" Background="LightBlue" HorizontalAlignment="Left" Margin="20,10,0,0" VerticalAlignment="Top" Height="37" Width="76"/>
        </Grid>
        <Grid Margin="-10,21,10,0" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Image Name="KangouBruit" MouseLeftButtonDown="KangouMaxiBruit" HorizontalAlignment="Left" Height="230" Margin="10,24,0,0" VerticalAlignment="Top" Width="251" Source="/580b57fbd9996e24bc43bc80.png"/>
            <Button Background="pink" Content="Pause Kangourou&#xD;&#xA;" HorizontalAlignment="Left" Margin="196,24,0,0" VerticalAlignment="Top" Height="21" Width="106" Click="Button_Click_1"/>
        </Grid>
        <DataGrid CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" SelectionChanged="DataGrid_SelectionChanged" SelectionMode="Single" ItemsSource="{Binding Kangourous, Mode=OneWay}" SelectedItem="{Binding SelectedKangourou, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" Background="{x:Null}" Margin="468,70,0,10" Grid.Row="1" HorizontalAlignment="Left" Width="322">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Code" Binding="{Binding codeKangourou}" />
                <DataGridTextColumn Header="Nom" Binding="{Binding nomKangourou}" />
                <DataGridTextColumn Header="Taille" Binding="{Binding tailleKangourou}" />
                <DataGridTextColumn Header="Poids" Binding="{Binding poidsKangourou}" />
                <DataGridTextColumn Header="Race" Binding="{Binding raceKangourou}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>

</Window>
